{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "commit_sha",
    "program",
    "examples",
    "needs",
    "touches",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "program": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "description": "Each example the program passes, in the owner's terms",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "says"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "says": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "needs": {
      "type": "string",
      "minLength": 1,
      "description": "What it needs installed, in the owner's terms: Python and each package, and why"
    },
    "touches": {
      "type": "string",
      "minLength": 1,
      "description": "What it may touch, in the owner's terms"
    },
    "own_tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tests of your own in the program's tests/ folder, if any"
    },
    "summary": {
      "type": "string"
    }
  }
}
