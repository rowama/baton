      "title": "RunInputs",
      "type": "object"
    },
    "SchemaGate": {
      "additionalProperties": false,
      "properties": {
        "advisory": {
          "default": false,
          "title": "Advisory",
          "type": "boolean"
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "type": {
          "const": "schema",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "SchemaGate",
      "type": "object"
    },
    "ScriptGate": {
      "additionalProperties": false,
      "properties": {
        "advisory": {
          "default": false,
          "title": "Advisory",
          "type": "boolean"
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
