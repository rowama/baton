          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "title": "Protect",
      "type": "object"
    },
    "Publish": {
      "additionalProperties": false,
      "properties": {
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "title": "Publish",
      "type": "object"
    },
    "Requires": {
      "additionalProperties": false,
