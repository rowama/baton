        "artifacts": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "doc_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Template"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "S",
                "M",
                "L"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "effort_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort From"
        },
        "gates": {
          "items": {
            "discriminator": {
              "mapping": {
                "findings": "#/$defs/FindingsGate",
                "human": "#/$defs/HumanGate",
                "review": "#/$defs/ReviewGate",
                "schema": "#/$defs/SchemaGate",
                "script": "#/$defs/ScriptGate"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SchemaGate"
              },
              {
                "$ref": "#/$defs/ScriptGate"
              },
              {
                "$ref": "#/$defs/ReviewGate"
              },
              {
                "$ref": "#/$defs/FindingsGate"
              },
              {
                "$ref": "#/$defs/HumanGate"
              }
            ]
          },
          "title": "Gates",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "independence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Independence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "title": "Inputs",
          "type": "array"
        },
        "output_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "protect": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/Protect"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protect"
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "workspace": {
          "default": "none",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "id",
        "requires",
        "prompt"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities_vocab": {
      "title": "Capabilities Vocab",
      "type": "string"
    },
    "complexity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Complexity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "format": {
      "title": "Format",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "run_inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunInputs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sme": {
      "anyOf": [
        {
          "$ref": "#/$defs/SmeRequirements"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Step"
          },
          {
            "$ref": "#/$defs/Group"
          }
        ]
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "format",
    "capabilities_vocab",
    "steps"
  ],
  "title": "baton-recipe/1",
  "type": "object"
}
