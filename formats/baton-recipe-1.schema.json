        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "publish": {
          "anyOf": [
            {
              "$ref": "#/$defs/Publish"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Complexity": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "triage_step": {
          "title": "Triage Step",
          "type": "string"
        }
      },
      "required": [
        "levels",
        "triage_step"
      ],
      "title": "Complexity",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "FindingsGate": {
      "additionalProperties": false,
      "properties": {
        "advisory": {
          "default": false,
          "title": "Advisory",
          "type": "boolean"
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "block_on": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block On"
        },
        "type": {
          "const": "findings",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FindingsGate",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "description": "A step containing steps: a sub-process (\u00a75.4).",
      "properties": {
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "concurrency": {
          "default": 1,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "foreach": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foreach"
        },
        "foreach_if_source_skipped": {
          "anyOf": [
            {
              "enum": [
                "once",
                "skip"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foreach If Source Skipped"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "max_iterations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Iterations"
        },
        "repeat_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat From"
        },
        "repeat_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Until"
        },
        "steps": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Step"
              },
              {
                "$ref": "#/$defs/Group"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "id",
        "steps"
      ],
      "title": "Group",
      "type": "object"
    },
    "HumanGate": {
      "additionalProperties": false,
      "properties": {
        "advisory": {
          "default": false,
          "title": "Advisory",
          "type": "boolean"
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "labels": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanGateLabels"
