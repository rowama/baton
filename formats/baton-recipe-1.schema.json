        "type": {
          "const": "human",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "prompt"
      ],
      "title": "HumanGate",
      "type": "object"
    },
    "HumanGateLabels": {
      "additionalProperties": false,
      "description": "A recipe's own plain-language labels for a human gate's options (\u00a713.8).",
      "properties": {
        "approve": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
