          ],
          "default": null,
          "title": "Approve"
        },
        "reject": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reject"
        }
      },
      "title": "HumanGateLabels",
      "type": "object"
    },
    "Independence": {
      "additionalProperties": false,
      "properties": {
        "from_step": {
          "title": "From Step",
          "type": "string"
        },
        "level": {
          "enum": [
            "different_profile",
            "different_model",
            "different_vendor"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "from_step",
        "level"
      ],
      "title": "Independence",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "from"
