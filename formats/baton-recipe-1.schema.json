        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/Requires"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SmeRequirements",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A leaf step: one unit of work done by one worker per attempt.",
      "properties": {
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
