          "title": "Min Context Tokens"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        }
      },
      "title": "Requires",
      "type": "object"
    },
    "ReviewGate": {
      "additionalProperties": false,
      "properties": {
        "advisory": {
          "default": false,
          "title": "Advisory",
          "type": "boolean"
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "block_on": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block On"
        },
        "independence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Independence"
