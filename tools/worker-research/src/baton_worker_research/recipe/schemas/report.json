{
  "type": "object",
  "required": ["inclusion_criteria", "providers_covered", "categories_covered", "coverage_gaps", "changes"],
  "properties": {
    "inclusion_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "providers_covered": { "type": "array", "items": { "type": "string" } },
    "categories_covered": { "type": "array", "items": { "type": "string" } },
    "coverage_gaps": { "type": "array", "items": { "type": "string" }, "description": "What was not covered, or could not be confirmed, and why" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why", "sources"],
        "properties": { "what": { "type": "string" }, "why": { "type": "string" }, "sources": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "notes": { "type": "string" }
  }
}
