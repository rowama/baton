{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "summary",
    "scope",
    "work"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "One paragraph: the work being asked for"
    },
    "scope": {
      "type": "object",
      "required": [
        "kind",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "developing_a_process",
            "executing_a_process",
            "other_work"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "The work being assessed, in a sentence"
        },
        "target": {
          "type": "string",
          "description": "Where a developed process will run or be used; described, never scored"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "judgment",
        "dependent_reasoning",
        "handoffs",
        "duration",
        "participants",
        "record_value",
        "latency_sensitive",
        "live_integration",
        "bulk_processing"
      ],
      "properties": {
        "frequency": {
          "type": "string",
          "description": "How often the assessed work happens or starts"
        },
        "judgment": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "dependent_reasoning": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "handoffs": {
          "type": "boolean",
          "description": "Work passes between several workers or people"
        },
        "duration": {
          "type": "string",
          "description": "How long the work takes end to end"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_signoffs": {
          "type": "boolean"
        },
        "record_value": {
          "enum": [
            "benefit",
            "neutral",
            "burden"
          ]
        },
        "latency_sensitive": {
          "type": "boolean"
        },
        "live_integration": {
          "type": "boolean"
        },
        "bulk_processing": {
          "type": "boolean"
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "description": "What was inferred rather than told, for the Director to confirm with the owner",
      "items": {
        "type": "object",
        "required": [
          "field",
          "value",
          "basis"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "description": "The profile field inferred, e.g. occurrence.frequency"
          },
          "value": {
            "description": "The inferred value"
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "description": "Why, in the owner's terms"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
