{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["slices"],
  "properties": {
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "outcome", "criteria", "effort"],
        "properties": {
          "id": {"type": "string", "description": "Runtime-assigned; echo it for kept items, omit it for new ones"},
          "title": {"type": "string"},
          "outcome": {"type": "string"},
          "criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "effort": {"enum": ["S", "M", "L"]}
        }
      }
    }
  }
}
