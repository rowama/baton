{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "kind", "feature_request"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["feature", "increment", "fix"]},
    "feature_request": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
