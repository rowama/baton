{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "idea"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "idea": {
      "type": "string",
      "minLength": 1,
      "description": "The process, in the owner's words"
    },
    "profile": {
      "type": "object",
      "description": "A fit-check profile of the idea, when there is one"
    },
    "base_recipe": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+$",
      "description": "id@version of a recipe to specialize"
    }
  },
  "additionalProperties": false
}
