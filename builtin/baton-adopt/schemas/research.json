{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baton-research/1",
  "title": "baton-research/1: adoption research findings (\u00a711.2)",
  "type": "object",
  "required": [
    "evidence",
    "work_items",
    "proposed_seeds",
    "gaps"
  ],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "confidence"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string"
          },
          "maps_to": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "finished",
              "in_flight"
            ]
          },
          "position": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "proposed_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "work_item",
          "step"
        ],
        "properties": {
          "work_item": {
            "type": "string"
          },
          "step": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)?$"
          },
          "item": {
            "type": "integer",
            "minimum": 0
          },
          "output": {},
          "output_from": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "gate",
                "evidence"
              ],
              "properties": {
                "gate": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "agent_config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "path_candidates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "command_candidates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
