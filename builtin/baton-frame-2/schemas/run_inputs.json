{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "words",
    "recipes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "words": {
      "type": "string",
      "minLength": 1,
      "description": "The owner's goal, verbatim"
    },
    "recipes": {
      "type": "array",
      "description": "Recipes a part may propose: vendored ones and those shipped with the runtime",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "description",
          "levels",
          "run_inputs",
          "vendored"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run_inputs": {
            "type": [
              "object",
              "null"
            ]
          },
          "vendored": {
            "type": "boolean"
          },
          "axes": {
            "type": "object"
          },
          "scope": {
            "type": [
              "object",
              "null"
            ]
          },
          "project_inputs": {
            "type": "array",
            "description": "The project document roles the recipe can build on (role, description, media_type?, required, many)"
          }
        },
        "additionalProperties": false
      }
    },
    "rubric": {
      "type": "string",
      "description": "fit-check's rubric: how the work a part describes is judged for fit"
    },
    "documents": {
      "type": "array",
      "description": "The project's documents a proposal may bind: path, kind, media_type, state (never their contents)",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
